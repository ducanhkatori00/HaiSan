{
  "name": "hoang-huy-seafood",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "build": "vite build",
    "start": "npm run start:api",
    "test": "node --test",
    "dev:api": "node --watch server/index.js",
    "dev:ui": "vite",
    "start:api": "node server/index.js",
    "preview": "vite preview",
    "preview:full": "concurrently -k \"npm run start:api\" \"npm run preview\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
